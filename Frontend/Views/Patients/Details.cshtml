@model Frontend.Models.PatientDetailsViewModel

@{
    ViewData["Title"] = "Détails du patient";
}

<h1>Détails du patient</h1>

<hr />

<h3>Informations personnelles</h3>

<dl class="row">
    <dt class="col-sm-3">Prénom</dt>
    <dd class="col-sm-9">@Model.Patient.FirstName</dd>

    <dt class="col-sm-3">Nom</dt>
    <dd class="col-sm-9">@Model.Patient.LastName</dd>

    <dt class="col-sm-3">Date de naissance</dt>
    <dd class="col-sm-9">
        @Model.Patient.DateOfBirth.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Patient.Gender</dd>

    <dt class="col-sm-3">Adresse</dt>
    <dd class="col-sm-9">@Model.Patient.Address</dd>

    <dt class="col-sm-3">Téléphone</dt>
    <dd class="col-sm-9">@Model.Patient.PhoneNumber</dd>
</dl>

<hr class="my-4" />

<h3>Évaluation du risque de diabète</h3>

@if (Model.RiskAssessment == null)
{
    <div class="alert alert-warning">
        Impossible de calculer le risque pour ce patient.
    </div>
}
else
{
    var riskClass = Model.RiskAssessment.RiskLevel switch
    {
        "None" => "alert-success",
        "Borderline" => "alert-info",
        "In Danger" => "alert-warning",
        "Early onset" => "alert-danger",
        _ => "alert-secondary"
    };

    <div class="alert @riskClass">
        <h4>
            Niveau de risque :
            @Model.RiskAssessment.RiskLevel
        </h4>

        <p class="mb-1">
            Âge : @Model.RiskAssessment.Age ans
        </p>

        <p class="mb-0">
            Déclencheurs détectés :
            @Model.RiskAssessment.TriggerCount
        </p>
    </div>
}

<a asp-action="Edit"
   asp-route-id="@Model.Patient.Id"
   class="btn btn-warning">
    Modifier les informations
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Retour
</a>

<hr class="my-4" />

<h3>Historique des notes</h3>

@if (Model.Notes.Count == 0)
{
    <div class="alert alert-info">
        Aucune note enregistrée pour ce patient.
    </div>
}
else
{
    @foreach (var note in Model.Notes)
    {
        <div class="card mb-3">
            <div class="card-body">

                <small class="text-muted">
                    @note.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </small>
                <p class="mt-2"
                   style="white-space: pre-wrap;">@note.Content</p>

            </div>
        </div>
    }
}

<hr class="my-4" />

<h3>Ajouter une note</h3>

@if (TempData["NoteError"] != null)
{
    <div class="alert alert-danger">
        @TempData["NoteError"]
    </div>
}

<form asp-controller="Patients"
      asp-action="AddNote"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="patientId"
           value="@Model.Patient.Id" />

    <div class="mb-3">

        <label for="newNoteContent"
               class="form-label">
            Note du médecin
        </label>

        <textarea name="newNoteContent"
                  id="newNoteContent"
                  class="form-control"
                  rows="6"
                  placeholder="Saisissez la note médicale..."
                  required></textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Ajouter la note
    </button>

</form>