{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/patients",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "patientservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/patients",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/patients/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "patientservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/patients/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT" ]
    },
    {
      "DownstreamPathTemplate": "/api/notes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "noteservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/notes",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/notes/patient/{patientId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "noteservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/notes/patient/{patientId}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/risk/{patientId}",
      "DownstreamScheme": "http",
